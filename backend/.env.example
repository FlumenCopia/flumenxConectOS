# Server Configuration (Use 5040 in production VPS to avoid collision with other services)
PORT=5040
NODE_ENV=production
# Local MongoDB on VPS or MongoDB Atlas URI:
MONGODB_URI=mongodb://127.0.0.1:27017/flumenx_conect_os

# Authentication & Cryptographic Keys (Must be minimum 32 chars and 64 hex chars respectively)
JWT_SECRET=replace_with_a_secure_random_key_min_32_characters_long
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET_KEY=replace_with_a_64_hex_character_encryption_key_for_aes_256_gcm
CORS_ORIGIN=https://connectos.flumenx.in

# Frontend Base Application URL (for generating clickable email reset & invitation links)
APP_URL=https://connectos.flumenx.in

# Initial Super Admin Bootstrap (Must be changed immediately upon first login)
INITIAL_ADMIN_NAME=FlumenX Administrator
INITIAL_ADMIN_EMAIL=admin@flumenx.com
INITIAL_ADMIN_PASSWORD=AdminStrongPassword123!

# SMTP Email Configuration (Nodemailer)
# Configure with your SMTP provider (e.g. Titan, Hostinger Webmail, Google Workspace, AWS SES, Brevo)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@flumenx.in
SMTP_PASS=YourEmailPasswordOrAppPasswordHere
SMTP_FROM="FlumenX ConectOS" <noreply@flumenx.in>

# Meta Webhook Signature Verification (App Secret from Meta Developer Portal > App Settings > Basic)
# Optional separate Instagram Login App Secret if Instagram DMs do not use the main Meta App Secret
META_APP_SECRET=replace_with_meta_app_secret_from_developer_portal
# META_INSTAGRAM_APP_SECRET=replace_only_if_using_separate_instagram_login_app_secret
# Verify Token chosen in Meta Developer Portal > Webhooks configuration for GET challenge handshake
META_VERIFY_TOKEN=replace_with_random_meta_webhook_verify_token

# Canonical Public HTTPS Base URL for Webhook Signature Validation (e.g. Twilio X-Twilio-Signature)
# Must match the public origin configured in Twilio Console (without /api/v1/... path)
PUBLIC_WEBHOOK_BASE_URL=https://connectos.flumenx.in
# Optional Twilio-specific override if Twilio callbacks use a different public base URL than PUBLIC_WEBHOOK_BASE_URL
# TWILIO_WEBHOOK_BASE_URL=https://connectos.flumenx.in
