{
  "name": "flumenx-conect-os-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API service for flumenxConectOS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seedSuperAdmin.ts",
    "smoke:manual": "tsx src/scripts/executeManualSmoke.ts",
    "verify:scanner": "tsx src/scripts/verifyStagingScannerLifecycle.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/auth.test.ts && tsx src/tests/clientManagement.test.ts && tsx src/tests/leadManagement.test.ts && tsx src/tests/conversations.test.ts && tsx src/tests/websiteForms.test.ts && tsx src/tests/adPlatform.test.ts && tsx src/tests/tasks.test.ts && tsx src/tests/reports.test.ts && tsx src/tests/workflows.test.ts && tsx src/tests/portal.test.ts",
    "test:portal": "tsx src/tests/portal.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "node-cron": "^3.0.3",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "rimraf": "^5.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
