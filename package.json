{
  "name": "flumenx-conect-os",
  "version": "1.0.0",
  "private": true,
  "description": "flumenxConectOS - Internal Digital Marketing Operations Platform for FlumenX",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "keywords": [
    "crm",
    "marketing-operations",
    "multi-client",
    "unified-inbox",
    "flumenx"
  ],
  "author": "FlumenX Engineering",
  "license": "UNLICENSED"
}
